        <messages/>
        <name>Can't Select Future Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var inputDate = g_form.getValue("date");
   var today = new Date();
   var inputDateObj = new Date(inputDate);

   if(inputDateObj > today){
	g_form.setValue("date", "");
	g_form.addErrorMessage("You cannot select a future date.")
   }
   
}]]></script>
